import { Button, CheckBox, ComboBox, LineEdit, TextEdit, ScrollView, TabWidget, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";

component IconButton {
    in property <string> text;
    callback clicked();

    min-width: 32px;
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        border-radius: 6px;
        background: #2d3748;
        border-width: 1px;
        border-color: #4a5568;

        HorizontalLayout {
            padding: 6px;
            alignment: center;

            Text {
                text: root.text;
                font-family: "Segoe UI Symbol";
                font-size: 14px;
                color: #e2e8f0;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

component KeyButton {
    in-out property <int> key-num;
    in-out property <bool> pressed;
    callback clicked();

    min-width: 56px;
    min-height: 42px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    rect := Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: #4a5568;
        background: root.pressed ? #1f9d55 : #2d3748;

        animate background { duration: 150ms; easing: ease; }

        Text {
            text: root.key-num;
            color: root.pressed ? #ffffff : #e2e8f0;
            font-weight: 700;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

component EncoderDisplay {
    in-out property <string> direction;
    in-out property <bool> btn-pressed;
    callback ccw-clicked();
    callback cw-clicked();
    callback btn-clicked();

    min-height: 90px;
    horizontal-stretch: 0;

    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: #4a5568;
        background: #1a202c;

        HorizontalLayout {
            padding: 6px;
            spacing: 4px;

            ccw-area := Rectangle {
                border-radius: 8px;
                background: root.direction == "ccw" ? #1f9d55 : #2d3748;
                min-width: 44px;
                vertical-stretch: 1;

                animate background { duration: 150ms; easing: ease; }

                Text {
                    text: "\u{25c0}";
                    color: #e2e8f0;
                    font-size: 14px;
                    font-family: "Segoe UI Symbol";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.ccw-clicked(); }
                }
            }

            knob := Rectangle {
                border-radius: 24px;
                border-width: 2px;
                border-color: #4a5568;
                background: #2d3748;
                min-width: 50px;
                min-height: 50px;
                horizontal-stretch: 0;
                vertical-stretch: 0;

                btn-div := Rectangle {
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: root.btn-pressed ? #1f9d55 : #4a5568;
                    background: root.btn-pressed ? #1f9d55 : #374151;
                    min-width: 12px;
                    min-height: 12px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;

                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }
                }
                TouchArea {
                    clicked => { root.btn-clicked(); }
                }
            }

            cw-area := Rectangle {
                border-radius: 8px;
                background: root.direction == "cw" ? #1f9d55 : #2d3748;
                min-width: 44px;
                vertical-stretch: 1;

                animate background { duration: 150ms; easing: ease; }

                Text {
                    text: "\u{25b6}";
                    color: #e2e8f0;
                    font-size: 14px;
                    font-family: "Segoe UI Symbol";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.cw-clicked(); }
                }
            }
        }
    }
}

component SectionLabel {
    in property <string> label;

    min-height: 22px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: #a0aec0;
        font-size: 12px;
        font-weight: 600;
    }
}

export component MainWindow inherits Window {
    title: "Pico Keypad";
    preferred-width: 1020px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 500px;

    background: #171923;

    in-out property <string> port-text: "";
    in-out property <[string]> port-list;
    in-out property <string> status-text: "Disconnected";
    in-out property <bool> connected: false;

    in-out property <bool> key-1-pressed: false;
    in-out property <bool> key-2-pressed: false;
    in-out property <bool> key-3-pressed: false;
    in-out property <bool> key-4-pressed: false;
    in-out property <bool> key-5-pressed: false;
    in-out property <bool> key-6-pressed: false;
    in-out property <bool> key-7-pressed: false;
    in-out property <bool> key-8-pressed: false;
    in-out property <bool> key-9-pressed: false;
    in-out property <bool> key-10-pressed: false;
    in-out property <bool> key-11-pressed: false;
    in-out property <bool> key-12-pressed: false;

    in-out property <string> encoder-direction: "";
    in-out property <bool> encoder-btn-pressed: false;

    in-out property <image> oled-preview-image;

    in-out property <string> text-input: "Pico Keypad\nReady";

    in-out property <string> splash-status: "No splash loaded";

    in-out property <[string]> binding-events;
    in-out property <string> binding-event: "";
    in-out property <[string]> binding-kinds;
    in-out property <string> binding-kind: "";
    in-out property <string> binding-value: "";
    in-out property <[string]> available-keys;
    in-out property <string> selected-key: "";

    in-out property <[string]> display-events;
    in-out property <string> display-event: "";
    in-out property <[string]> display-kinds;
    in-out property <string> display-kind: "";
    in-out property <string> display-value: "";

    in-out property <bool> image-invert: false;

    in-out property <[string]> log-lines;

    in-out property <[string]> bindings-model;
    in-out property <[string]> display-rules-model;
    in-out property <int> selected-binding-index: -1;
    in-out property <int> selected-display-rule-index: -1;

    callback connect-clicked();
    callback disconnect-clicked();
    callback toggle-connection();
    callback refresh-ports();
    callback key-clicked(int);
    callback encoder-ccw-clicked();
    callback encoder-cw-clicked();
    callback encoder-btn-clicked();

    callback send-text();
    callback load-image();
    callback clear-display();
    callback load-splash-preview();
    callback save-current-splash();
    callback send-splash-to-device();

    callback save-binding();
    callback test-binding();
    callback clear-binding();
    callback insert-key();

    callback save-display-rule();
    callback test-display-rule();
    callback clear-display-rule();
    callback browse-display-image();

    callback binding-event-changed(string);
    callback binding-kind-changed(string);
    callback binding-item-selected(int);

    callback display-event-changed(string);
    callback display-kind-changed(string);
    callback display-item-selected(int);

    callback poll-messages();
    callback watchdog-tick();

    in-out property <bool> msg-timer-running: false;
    in-out property <bool> wd-timer-running: false;

    msg-timer := Timer {
        interval: 50ms;
        running <=> root.msg-timer-running;
        triggered => { root.poll-messages(); }
    }

    wd-timer := Timer {
        interval: 1000ms;
        running <=> root.wd-timer-running;
        triggered => { root.watchdog-tick(); }
    }

    VerticalBox {
        toolbar := HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            alignment: center;
            min-height: 48px;

            Rectangle {
                background: #1a202c;
                border-radius: 8px;
                border-width: 1px;
                border-color: #2d3748;

                HorizontalLayout {
                    spacing: 8px;
                    padding: 6px;
                    alignment: center;

                Text {
                    text: "Port";
                    color: #718096;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                    ComboBox {
                        min-width: 200px;
                        model: root.port-list;
                        current-value <=> root.port-text;
                    }

                    IconButton {
                        text: "\u{21bb}";
                        clicked => { root.refresh-ports(); }
                    }
                }
            }

            Button {
                text: root.connected ? "Disconnect" : "Connect";
                clicked => { root.toggle-connection(); }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                Text {
                    text: root.status-text;
                    color: root.connected ? #68d391 : #a0aec0;
                    font-size: 13px;
                    font-weight: 500;
                    horizontal-alignment: end;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        main-area := HorizontalLayout {
            left-panel := VerticalLayout {
                min-width: 270px;
                horizontal-stretch: 0;
                padding: 10px;
                spacing: 10px;

                GroupBox {
                    title: "Keypad";

                    VerticalLayout {
                        spacing: 8px;
                        padding: 4px;

                        GridLayout {
                            spacing: 6px;
                            padding: 4px;

                            Row {
                                key-1 := KeyButton {
                                    key-num: 1;
                                    pressed: root.key-1-pressed;
                                    clicked => { root.key-clicked(1); }
                                }
                                key-2 := KeyButton {
                                    key-num: 2;
                                    pressed: root.key-2-pressed;
                                    clicked => { root.key-clicked(2); }
                                }
                                key-3 := KeyButton {
                                    key-num: 3;
                                    pressed: root.key-3-pressed;
                                    clicked => { root.key-clicked(3); }
                                }
                                key-4 := KeyButton {
                                    key-num: 4;
                                    pressed: root.key-4-pressed;
                                    clicked => { root.key-clicked(4); }
                                }
                            }
                            Row {
                                key-5 := KeyButton {
                                    key-num: 5;
                                    pressed: root.key-5-pressed;
                                    clicked => { root.key-clicked(5); }
                                }
                                key-6 := KeyButton {
                                    key-num: 6;
                                    pressed: root.key-6-pressed;
                                    clicked => { root.key-clicked(6); }
                                }
                                key-7 := KeyButton {
                                    key-num: 7;
                                    pressed: root.key-7-pressed;
                                    clicked => { root.key-clicked(7); }
                                }
                                key-8 := KeyButton {
                                    key-num: 8;
                                    pressed: root.key-8-pressed;
                                    clicked => { root.key-clicked(8); }
                                }
                            }
                            Row {
                                key-9 := KeyButton {
                                    key-num: 9;
                                    pressed: root.key-9-pressed;
                                    clicked => { root.key-clicked(9); }
                                }
                                key-10 := KeyButton {
                                    key-num: 10;
                                    pressed: root.key-10-pressed;
                                    clicked => { root.key-clicked(10); }
                                }
                                key-11 := KeyButton {
                                    key-num: 11;
                                    pressed: root.key-11-pressed;
                                    clicked => { root.key-clicked(11); }
                                }
                                key-12 := KeyButton {
                                    key-num: 12;
                                    pressed: root.key-12-pressed;
                                    clicked => { root.key-clicked(12); }
                                }
                            }
                        }

                        encoder := EncoderDisplay {
                            direction: root.encoder-direction;
                            btn-pressed: root.encoder-btn-pressed;
                            ccw-clicked => { root.encoder-ccw-clicked(); }
                            cw-clicked => { root.encoder-cw-clicked(); }
                            btn-clicked => { root.encoder-btn-clicked(); }
                        }
                    }
                }

                GroupBox {
                    title: "Log";

                    VerticalLayout {
                        vertical-stretch: 1;

                        ScrollView {
                            min-height: 100px;
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 1px;
                                padding: 4px;

                                for line in root.log-lines: Rectangle {
                                    min-height: 18px;
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    Text {
                                        text: line;
                                        color: #718096;
                                        font-size: 10px;
                                        font-family: "Consolas, monospace";
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            right-panel := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #1a202c;

                tabs := TabWidget {
                    Tab {
                        title: "Display";

                        ScrollView {
                            VerticalBox {
                                spacing: 12px;
                                padding: 10px;

                                Image {
                                    source: root.oled-preview-image;
                                    horizontal-stretch: 0;
                                    min-width: 256px;
                                    min-height: 64px;
                                    image-fit: contain;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Button { text: "Send Text"; clicked => { root.send-text(); } }
                                    Button { text: "Load Image"; clicked => { root.load-image(); } }
                                    Button { text: "Clear"; clicked => { root.clear-display(); } }

                                    CheckBox {
                                        text: "Invert";
                                        checked <=> root.image-invert;
                                    }
                                }

                                GroupBox {
                                    title: "Text";

                                    TextEdit {
                                        text <=> root.text-input;
                                        min-height: 50px;
                                        font-size: 13px;
                                        font-family: "Consolas, monospace";
                                    }
                                }

                                GroupBox {
                                    title: "Splash";

                                    VerticalBox {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            Button { text: "Load"; clicked => { root.load-splash-preview(); } }
                                            Button { text: "Save"; clicked => { root.save-current-splash(); } }
                                            Button { text: "Send to device"; clicked => { root.send-splash-to-device(); } }
                                        }

                                        Text {
                                            text: root.splash-status;
                                            color: #a0aec0;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }

                                GroupBox {
                                    title: "Display Rules";

                                    VerticalBox {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            VerticalBox {
                                                min-width: 200px;

                                                SectionLabel { label: "Input"; }
                                                ComboBox {
                                                    model: root.display-events;
                                                    current-value <=> root.display-event;
                                                    selected(value) => {
                                                        root.display-event-changed(value);
                                                    }
                                                }
                                            }

                                            VerticalBox {
                                                min-width: 140px;

                                                SectionLabel { label: "Content"; }
                                                ComboBox {
                                                    model: root.display-kinds;
                                                    current-value <=> root.display-kind;
                                                    selected(value) => {
                                                        root.display-kind-changed(value);
                                                    }
                                                }
                                            }
                                        }

                                        SectionLabel { label: "Text or image path"; }
                                        TextEdit {
                                            text <=> root.display-value;
                                            min-height: 60px;
                                            font-size: 12px;
                                            font-family: "Consolas, monospace";
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Button { text: "Save"; clicked => { root.save-display-rule(); } }
                                            Button { text: "Test"; clicked => { root.test-display-rule(); } }
                                            Button { text: "Browse..."; clicked => { root.browse-display-image(); } }
                                            Button { text: "Clear"; clicked => { root.clear-display-rule(); } }
                                        }

                                        ScrollView {
                                            min-height: 100px;
                                            vertical-stretch: 1;

                                            VerticalLayout {
                                                spacing: 2px;

                                                for rule[idx] in root.display-rules-model: Rectangle {
                                                    min-height: 26px;
                                                    horizontal-stretch: 1;
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: #2d3748;
                                                    background: idx == root.selected-display-rule-index ? #2d3748 : transparent;

                                                    Text {
                                                        text: rule;
                                                        color: idx == root.selected-display-rule-index ? #e2e8f0 : #a0aec0;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: start;
                                                        overflow: elide;
                                                    }

                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-display-rule-index = idx;
                                                            root.display-item-selected(idx);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Tab {
                        title: "Bindings";

                        ScrollView {
                            VerticalBox {
                                spacing: 12px;
                                padding: 10px;

                                GroupBox {
                                    title: "Editor";

                                    VerticalBox {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            VerticalBox {
                                                min-width: 200px;

                                                SectionLabel { label: "Input"; }
                                                ComboBox {
                                                    model: root.binding-events;
                                                    current-value <=> root.binding-event;
                                                    selected(value) => {
                                                        root.binding-event-changed(value);
                                                    }
                                                }
                                            }

                                            VerticalBox {
                                                min-width: 140px;

                                                SectionLabel { label: "Action"; }
                                                ComboBox {
                                                    model: root.binding-kinds;
                                                    current-value <=> root.binding-kind;
                                                    selected(value) => {
                                                        root.binding-kind-changed(value);
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;

                                            VerticalBox {
                                                min-width: 200px;

                                                SectionLabel { label: "Keys"; }
                                                ComboBox {
                                                    model: root.available-keys;
                                                    current-value <=> root.selected-key;
                                                }
                                            }

                                            Button {
                                                text: "Insert";
                                                clicked => { root.insert-key(); }
                                                vertical-stretch: 0;
                                            }
                                        }

                                        SectionLabel { label: "Value / macro"; }
                                        TextEdit {
                                            text <=> root.binding-value;
                                            min-height: 55px;
                                            font-size: 12px;
                                            font-family: "Consolas, monospace";
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Button { text: "Save"; clicked => { root.save-binding(); } }
                                            Button { text: "Test"; clicked => { root.test-binding(); } }
                                            Button { text: "Clear"; clicked => { root.clear-binding(); } }
                                        }
                                    }
                                }

                                GroupBox {
                                    title: "All Bindings";

                                    VerticalBox {
                                        vertical-stretch: 1;

                                        ScrollView {
                                            min-height: 140px;
                                            vertical-stretch: 1;

                                            VerticalLayout {
                                                spacing: 2px;

                                                for binding[idx] in root.bindings-model: Rectangle {
                                                    min-height: 26px;
                                                    horizontal-stretch: 1;
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: #2d3748;
                                                    background: idx == root.selected-binding-index ? #2d3748 : transparent;

                                                    Text {
                                                        text: binding;
                                                        color: idx == root.selected-binding-index ? #e2e8f0 : #a0aec0;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: start;
                                                        overflow: elide;
                                                    }

                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-binding-index = idx;
                                                            root.binding-item-selected(idx);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
