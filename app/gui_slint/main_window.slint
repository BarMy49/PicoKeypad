import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    TextEdit,
    ScrollView,
    TabWidget,
    VerticalBox,
    HorizontalBox,
    GroupBox,
} from "std-widgets.slint";

component IconButton {
    in property <string> text;
    callback clicked();

    min-width: 32px;
    min-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        border-radius: 6px;
        background: #2d3748;
        border-width: 1px;
        border-color: #4a5568;

        HorizontalLayout {
            padding: 6px;
            alignment: center;

            Text {
                text: root.text;
                font-family: "Segoe UI Symbol";
                font-size: 14px;
                color: #e2e8f0;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

component KeyButton {
    in-out property <int> key-num;
    in-out property <bool> pressed;
    callback clicked();

    width: 90px;
    height: 90px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    rect := Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: #4a5568;
        background: root.pressed ? #1f9d55 : #2d3748;

        animate background {
            duration: 150ms;
            easing: ease;
        }

        Text {
            text: root.key-num;
            color: root.pressed ? #ffffff : #e2e8f0;
            font-weight: 700;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

component EncoderDisplay {
    in-out property <string> direction;
    in-out property <bool> btn-pressed;
    callback ccw-clicked();
    callback cw-clicked();
    callback btn-clicked();

    min-height: 90px;
    max-height: 90px;
    horizontal-stretch: 0;

    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: #4a5568;
        background: #1a202c;

        HorizontalLayout {
            padding: 6px;
            spacing: 4px;

            ccw-area := Rectangle {
                border-radius: 8px;
                background: root.direction == "ccw" ? #1f9d55 : #2d3748;
                min-width: 44px;
                vertical-stretch: 1;

                animate background {
                    duration: 150ms;
                    easing: ease;
                }

                Text {
                    text: "\u{25c0}";
                    color: #e2e8f0;
                    font-size: 14px;
                    font-family: "Segoe UI Symbol";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.ccw-clicked(); }
                }
            }

            knob := Rectangle {
                border-radius: 24px;
                border-width: 2px;
                border-color: #4a5568;
                background: #2d3748;
                min-width: 50px;
                min-height: 50px;
                horizontal-stretch: 0;
                vertical-stretch: 0;

                btn-div := Rectangle {
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: root.btn-pressed ? #1f9d55 : #4a5568;
                    background: root.btn-pressed ? #1f9d55 : #374151;
                    min-width: 12px;
                    min-height: 12px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;

                    animate background { duration: 100ms; }
                    animate border-color { duration: 100ms; }
                }

                TouchArea {
                    clicked => { root.btn-clicked(); }
                }
            }

            cw-area := Rectangle {
                border-radius: 8px;
                background: root.direction == "cw" ? #1f9d55 : #2d3748;
                min-width: 44px;
                vertical-stretch: 1;

                animate background {
                    duration: 150ms;
                    easing: ease;
                }

                Text {
                    text: "\u{25b6}";
                    color: #e2e8f0;
                    font-size: 14px;
                    font-family: "Segoe UI Symbol";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.cw-clicked(); }
                }
            }
        }
    }
}

component SectionLabel {
    in property <string> label;

    min-height: 22px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: #a0aec0;
        font-size: 12px;
        font-weight: 600;
    }
}

component CollapseHeader {
    in property <string> title;
    in-out property <bool> collapsed;

    min-height: 32px;
    max-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    Rectangle {
        background: #2d3748;
        border-radius: 6px;

        TouchArea {
            clicked => { root.collapsed = !root.collapsed; }
        }

        HorizontalLayout {
            padding: 6px;

            arrow := Text {
                text: root.collapsed ? "▸" : "▾";
                color: #718096;
                font-size: 11px;
                font-family: "Segoe UI Symbol";
                vertical-alignment: center;
            }

            Text {
                text: root.title;
                color: #e2e8f0;
                font-weight: 600;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Pico Keypad";
    icon: @image-url("../icon_win.png");
    preferred-width: 1020px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 750px;

    background: #171923;

    in-out property <string> port-text: "";
    in-out property <[string]> port-list;
    in-out property <string> status-text: "Disconnected";
    in-out property <bool> connected: false;

    in-out property <bool> key-1-pressed: false;
    in-out property <bool> key-2-pressed: false;
    in-out property <bool> key-3-pressed: false;
    in-out property <bool> key-4-pressed: false;
    in-out property <bool> key-5-pressed: false;
    in-out property <bool> key-6-pressed: false;
    in-out property <bool> key-7-pressed: false;
    in-out property <bool> key-8-pressed: false;
    in-out property <bool> key-9-pressed: false;
    in-out property <bool> key-10-pressed: false;
    in-out property <bool> key-11-pressed: false;
    in-out property <bool> key-12-pressed: false;

    in-out property <string> encoder-direction: "";
    in-out property <bool> encoder-btn-pressed: false;

    in-out property <image> oled-preview-image;

    in-out property <string> splash-status: "No splash loaded";

    in-out property <[string]> action-events;
    in-out property <string> action-event: "";
    in-out property <[string]> action-kinds;
    in-out property <string> action-kind: "";
    in-out property <string> action-value: "";
    in-out property <[string]> volume-values;
    in-out property <string> volume-value: "";
    in-out property <[string]> media-values;
    in-out property <string> media-value: "";
    in-out property <string> toggle-action-on: "";
    in-out property <string> toggle-action-off: "";
    in-out property <string> toggle-image-on: "";
    in-out property <string> toggle-image-off: "";
    in-out property <[string]> available-keys;
    in-out property <string> selected-key: "";

    in-out property <[string]> display-kinds;
    in-out property <string> display-kind: "";
    in-out property <string> display-value: "";

    in-out property <[string]> splash-modes;
    in-out property <string> splash-mode: "";
    in-out property <string> splash-interval: "";
    in-out property <string> splash-idle: "";
    in-out property <string> splash-template: "";
    in-out property <string> splash-font-size: "";
    in-out property <string> splash-line-spacing: "";
    in-out property <[string]> splash-alignments;
    in-out property <string> splash-alignment: "";

    in-out property <[string]> log-lines;

    in-out property <[string]> actions-model;
    in-out property <int> selected-action-index: -1;

    in-out property <bool> action-editor-collapsed: false;
    in-out property <bool> actions-list-collapsed: false;
    in-out property <bool> log-section-collapsed: false;

    in-out property <bool> connect-on-start: true;
    in-out property <bool> start-minimized: false;

    callback toggle-connection();
    callback refresh-ports();
    callback key-clicked(int);
    callback encoder-ccw-clicked();
    callback encoder-cw-clicked();
    callback encoder-btn-clicked();

    callback save-action();
    callback test-action();
    callback clear-action();
    callback insert-key();
    callback browse-display-image();
    callback browse-toggle-image-on();
    callback browse-toggle-image-off();

    callback action-event-changed(string);
    callback action-kind-changed(string);
    callback action-item-selected(int);
    callback display-kind-changed(string);

    callback load-splash-image();
    callback splash-save();
    callback splash-preview();

    callback poll-messages();
    callback watchdog-tick();

    callback settings-changed();

    in-out property <bool> msg-timer-running: false;
    in-out property <bool> wd-timer-running: false;

    msg-timer := Timer {
        interval: 50ms;
        running <=> root.msg-timer-running;
        triggered => { root.poll-messages(); }
    }

    wd-timer := Timer {
        interval: 1000ms;
        running <=> root.wd-timer-running;
        triggered => { root.watchdog-tick(); }
    }

    main-root := VerticalBox {
        vertical-stretch: 1;
        toolbar := HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            alignment: center;
            height: 65px;

            Rectangle {
                background: #1a202c;
                border-radius: 8px;
                border-width: 1px;
                border-color: #2d3748;

                HorizontalLayout {
                    spacing: 8px;
                    padding: 6px;
                    alignment: center;

                    Text {
                        text: "Port";
                        color: #718096;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    ComboBox {
                        min-width: 200px;
                        model: root.port-list;
                        current-value <=> root.port-text;
                    }

                    IconButton {
                        text: "\u{21bb}";
                        clicked => { root.refresh-ports(); }
                    }
                }
            }

            Button {
                text: root.connected ? "Disconnect" : "Connect";
                clicked => { root.toggle-connection(); }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                Text {
                    text: root.status-text;
                    color: root.connected ? #68d391 : #a0aec0;
                    font-size: 13px;
                    font-weight: 500;
                    horizontal-alignment: end;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        main-area := HorizontalLayout {
            vertical-stretch: 1;
            left-panel := VerticalLayout {
                min-width: 350px;
                horizontal-stretch: 0;
                vertical-stretch: 1;
                spacing: 10px;
                padding-right: 5px;

                Rectangle {
                    horizontal-stretch: 0;
                    background: #1a202c;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #4a5568;

                    VerticalLayout {
                        spacing: 8px;
                        padding: 10px;
                        vertical-stretch: 0;

                        Image {
                            source: root.oled-preview-image;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                            width: 384px;
                            height: 96px;
                            image-fit: contain;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 1px;
                            background: #2d3748;
                        }

                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;

                                key-1 := KeyButton {
                                    key-num: 1;
                                    pressed: root.key-1-pressed;
                                    clicked => { root.key-clicked(1); }
                                }

                                key-2 := KeyButton {
                                    key-num: 2;
                                    pressed: root.key-2-pressed;
                                    clicked => { root.key-clicked(2); }
                                }

                                key-3 := KeyButton {
                                    key-num: 3;
                                    pressed: root.key-3-pressed;
                                    clicked => { root.key-clicked(3); }
                                }

                                key-4 := KeyButton {
                                    key-num: 4;
                                    pressed: root.key-4-pressed;
                                    clicked => { root.key-clicked(4); }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;

                                key-5 := KeyButton {
                                    key-num: 5;
                                    pressed: root.key-5-pressed;
                                    clicked => { root.key-clicked(5); }
                                }

                                key-6 := KeyButton {
                                    key-num: 6;
                                    pressed: root.key-6-pressed;
                                    clicked => { root.key-clicked(6); }
                                }

                                key-7 := KeyButton {
                                    key-num: 7;
                                    pressed: root.key-7-pressed;
                                    clicked => { root.key-clicked(7); }
                                }

                                key-8 := KeyButton {
                                    key-num: 8;
                                    pressed: root.key-8-pressed;
                                    clicked => { root.key-clicked(8); }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;

                                key-9 := KeyButton {
                                    key-num: 9;
                                    pressed: root.key-9-pressed;
                                    clicked => { root.key-clicked(9); }
                                }

                                key-10 := KeyButton {
                                    key-num: 10;
                                    pressed: root.key-10-pressed;
                                    clicked => { root.key-clicked(10); }
                                }

                                key-11 := KeyButton {
                                    key-num: 11;
                                    pressed: root.key-11-pressed;
                                    clicked => { root.key-clicked(11); }
                                }

                                key-12 := KeyButton {
                                    key-num: 12;
                                    pressed: root.key-12-pressed;
                                    clicked => { root.key-clicked(12); }
                                }
                            }
                        }

                        encoder := EncoderDisplay {
                            vertical-stretch: 0;
                            direction: root.encoder-direction;
                            btn-pressed: root.encoder-btn-pressed;
                            ccw-clicked => { root.encoder-ccw-clicked(); }
                            cw-clicked => { root.encoder-cw-clicked(); }
                            btn-clicked => { root.encoder-btn-clicked(); }
                        }
                    }
                }

                CollapseHeader {
                    title: "Log";
                    collapsed <=> root.log-section-collapsed;
                }

                ScrollView {
                    min-height: root.log-section-collapsed ? 0px : 35px;
                    vertical-stretch: root.log-section-collapsed ? 0 : 1;
                    visible: !root.log-section-collapsed;

                    VerticalLayout {
                        spacing: 1px;
                        padding: 4px;

                        for line in root.log-lines: Rectangle {
                            height: 25px;
                            horizontal-stretch: 1;
                            background: #282d39;

                            Text {
                                text: line;
                                color: #718096;
                                font-size: 10px;
                                font-family: "Consolas, monospace";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            right-panel := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: #1a202c;

                tabs := TabWidget {
                    vertical-stretch: 1;

                    Tab {
                        title: "Actions";

                        VerticalLayout {
                            spacing: 12px;
                            padding: 10px;
                            vertical-stretch: 1;

                            CollapseHeader {
                                title: "Editor";
                                collapsed <=> root.action-editor-collapsed;
                            }

                            if !root.action-editor-collapsed: VerticalBox {
                                spacing: 6px;
                                vertical-stretch: 0;

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalBox {
                                        min-width: 200px;

                                        SectionLabel {
                                            label: "Input";
                                            height: 30px;
                                        }

                                        ComboBox {
                                            height: 30px;
                                            model: root.action-events;
                                            current-value <=> root.action-event;
                                            selected(value) => {
                                                root.action-event-changed(value);
                                            }
                                        }
                                    }

                                    VerticalBox {
                                        min-width: 140px;

                                        SectionLabel {
                                            label: "Response";
                                            height: 30px;
                                        }

                                        ComboBox {
                                            height: 30px;
                                            model: root.action-kinds;
                                            current-value <=> root.action-kind;
                                            selected(value) => {
                                                root.action-kind-changed(value);
                                            }
                                        }
                                    }
                                }

                                if root.action-kind == "hotkey": VerticalBox {
                                    spacing: 4px;

                                    SectionLabel {
                                        label: "Hotkey";
                                    }

                                    TextEdit {
                                        text <=> root.action-value;
                                        min-height: 55px;
                                        font-size: 12px;
                                        font-family: "Consolas, monospace";
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        SectionLabel {
                                            label: "Insert key";
                                        }

                                        ComboBox {
                                            model: root.available-keys;
                                            current-value <=> root.selected-key;
                                            selected(value) => {
                                                root.selected-key = value;
                                            }
                                        }

                                        Button {
                                            text: "Insert";
                                            clicked => { root.insert-key(); }
                                            vertical-stretch: 0;
                                        }
                                    }
                                }

                                if root.action-kind == "macro": VerticalBox {
                                    spacing: 4px;

                                    SectionLabel {
                                        label: "Macro";
                                    }

                                    TextEdit {
                                        text <=> root.action-value;
                                        min-height: 110px;
                                        font-size: 12px;
                                        font-family: "Consolas, monospace";
                                    }
                                }

                                if root.action-kind == "volume": VerticalBox {
                                    spacing: 4px;

                                    SectionLabel {
                                        label: "Volume action";
                                    }

                                    ComboBox {
                                        model: root.volume-values;
                                        current-value <=> root.volume-value;
                                    }
                                }

                                if root.action-kind == "media": VerticalBox {
                                    spacing: 4px;

                                    SectionLabel {
                                        label: "Media action";
                                    }

                                    ComboBox {
                                        model: root.media-values;
                                        current-value <=> root.media-value;
                                    }
                                }

                                if root.action-kind == "toggle": VerticalBox {
                                    spacing: 4px;

                                    SectionLabel {
                                        label: "Action when ON";
                                    }

                                    TextEdit {
                                        text <=> root.toggle-action-on;
                                        min-height: 45px;
                                        font-size: 12px;
                                        font-family: "Consolas, monospace";
                                    }

                                    SectionLabel {
                                        label: "Action when OFF";
                                    }

                                    TextEdit {
                                        text <=> root.toggle-action-off;
                                        min-height: 45px;
                                        font-size: 12px;
                                        font-family: "Consolas, monospace";
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        LineEdit {
                                            text <=> root.toggle-image-on;
                                            placeholder-text: "Image when ON (path)";
                                        }

                                        Button {
                                            text: "Browse...";
                                            clicked => { root.browse-toggle-image-on(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        LineEdit {
                                            text <=> root.toggle-image-off;
                                            placeholder-text: "Image when OFF (path)";
                                        }

                                        Button {
                                            text: "Browse...";
                                            clicked => { root.browse-toggle-image-off(); }
                                        }
                                    }
                                }

                                SectionLabel {
                                    label: "Display response";
                                    height: 30px;
                                }

                                ComboBox {
                                    model: root.display-kinds;
                                    current-value <=> root.display-kind;
                                    selected(value) => {
                                        root.display-kind-changed(value);
                                    }
                                }

                                if root.display-kind == "text": VerticalBox {
                                    spacing: 4px;

                                    SectionLabel {
                                        label: "Display text";
                                    }

                                    TextEdit {
                                        text <=> root.display-value;
                                        min-height: 55px;
                                        font-size: 12px;
                                        font-family: "Consolas, monospace";
                                    }
                                }

                                if root.display-kind == "image": HorizontalLayout {
                                    spacing: 6px;

                                    LineEdit {
                                        text <=> root.display-value;
                                        placeholder-text: "Image path";
                                    }

                                    Button {
                                        text: "Browse...";
                                        clicked => { root.browse-display-image(); }
                                    }
                                }

                                if root.display-kind == "volume_bar": Text {
                                    text: "Shows the current system volume bar.";
                                    color: #a0aec0;
                                    font-size: 11px;
                                }

                                if root.display-kind == "media_info": Text {
                                    text: "Shows the currently playing media.";
                                    color: #a0aec0;
                                    font-size: 11px;
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    Button {
                                        text: "Save";
                                        clicked => { root.save-action(); }
                                    }

                                    Button {
                                        text: "Test";
                                        clicked => { root.test-action(); }
                                    }

                                    Button {
                                        text: "Clear";
                                        clicked => { root.clear-action(); }
                                    }
                                }
                            }

                            CollapseHeader {
                                title: "All Actions";
                                collapsed <=> root.actions-list-collapsed;
                            }

                            if !root.actions-list-collapsed: Rectangle {
                                min-height: 140px;
                                vertical-stretch: 1;

                                ScrollView {
                                    width: parent.width;
                                    height: parent.height;

                                    VerticalLayout {
                                        spacing: 2px;

                                        for action[idx] in root.actions-model: Rectangle {
                                            height: 50px;
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #2d3748;
                                            background: idx == root.selected-action-index ? #2d3748 : transparent;

                                            Text {
                                                text: action;
                                                color: idx == root.selected-action-index ? #e2e8f0 : #a0aec0;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                horizontal-alignment: start;
                                                overflow: elide;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.selected-action-index = idx;
                                                    root.action-item-selected(idx);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Tab {
                        title: "Settings";

                        VerticalLayout {
                            spacing: 12px;
                            padding: 10px;
                            vertical-stretch: 1;

                            GroupBox {
                                title: "Connection";

                                VerticalBox {
                                    padding: 8px;
                                    spacing: 8px;

                                    CheckBox {
                                        text: "Connect on start";
                                        checked <=> root.connect-on-start;
                                        toggled => { root.settings-changed(); }
                                    }

                                    CheckBox {
                                        text: "Start minimized";
                                        checked <=> root.start-minimized;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                            }

                            GroupBox {
                                title: "Splash screen";

                                VerticalBox {
                                    padding: 8px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        VerticalBox {
                                            min-width: 160px;

                                            SectionLabel {
                                                label: "Mode";
                                            }

                                            ComboBox {
                                                model: root.splash-modes;
                                                current-value <=> root.splash-mode;
                                            }
                                        }

                                        VerticalBox {
                                            min-width: 120px;

                                            SectionLabel {
                                                label: "Update interval (s)";
                                            }

                                            LineEdit {
                                                text <=> root.splash-interval;
                                            }
                                        }

                                        VerticalBox {
                                            min-width: 120px;

                                            SectionLabel {
                                                label: "Idle timeout (s)";
                                            }

                                            LineEdit {
                                                text <=> root.splash-idle;
                                            }
                                        }
                                    }

                                    if root.splash-mode == "static": VerticalBox {
                                        spacing: 6px;

                                        SectionLabel {
                                            label: "Static image";
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Button {
                                                text: "Load image...";
                                                clicked => { root.load-splash-image(); }
                                            }

                                            Text {
                                                text: root.splash-status;
                                                color: #a0aec0;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    if root.splash-mode == "text" || root.splash-mode == "custom": VerticalBox {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            VerticalBox {
                                                min-width: 120px;

                                                SectionLabel {
                                                    label: "Font size (8-24)";
                                                }

                                                LineEdit {
                                                    text <=> root.splash-font-size;
                                                }
                                            }

                                            VerticalBox {
                                                min-width: 120px;

                                                SectionLabel {
                                                    label: "Line spacing (0-8)";
                                                }

                                                LineEdit {
                                                    text <=> root.splash-line-spacing;
                                                }
                                            }

                                            VerticalBox {
                                                min-width: 120px;

                                                SectionLabel {
                                                    label: "Alignment";
                                                }

                                                ComboBox {
                                                    model: root.splash-alignments;
                                                    current-value <=> root.splash-alignment;
                                                }
                                            }
                                        }
                                    }

                                    if root.splash-mode == "custom": VerticalBox {
                                        spacing: 4px;

                                        SectionLabel {
                                            label: "Template ({cpu}, {ram}, {disk}, {time}, {date}, ...)";
                                        }

                                        TextEdit {
                                            text <=> root.splash-template;
                                            min-height: 80px;
                                            font-size: 12px;
                                            font-family: "Consolas, monospace";
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;

                                        Button {
                                            text: "Save splash settings";
                                            clicked => { root.splash-save(); }
                                        }

                                        Button {
                                            text: "Preview";
                                            clicked => { root.splash-preview(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
